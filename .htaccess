# Apache (Bluehost) equivalent of _headers. Upload alongside index.html in public_html.

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# No directory listings; serve index.html
Options -Indexes
DirectoryIndex index.html

# Don't serve repo/housekeeping files if they get uploaded by accident
<FilesMatch "^(_headers|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(_backup-before-redesign|_unused|\.claude|\.git)(/|$)

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  # HSTS without includeSubDomains/preload so Bluehost's own subdomains (cpanel., webmail.) aren't affected
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-XSS-Protection "0"
</IfModule>

# Long-cache static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpe?g|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
